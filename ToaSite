      const show = matchHouse && matchBastard && matchAlive;

      tab.classList.toggle('hidden-char', !show);
      if (show) {
        anyVisible = true;
        if (!firstVisible) firstVisible = tab;
        if (tab.dataset.char === activeCharId) activeStillVisible = true;
