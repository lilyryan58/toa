  /* ── LOAD FROM GOOGLE DRIVE ─────────────────────────────── */
  async function loadGallery() {
    galleryLoadingMsg.textContent = 'Consulting the archive…';
    galleryEmpty.style.display = '';

    const mimeFilter = [
      'image/jpeg', 'image/png', 'image/gif',
      'image/webp', 'image/bmp', 'image/tiff'
    ].map(m => `mimeType='${m}'`).join(' or ');

    const url = `https://www.googleapis.com/drive/v3/files`
      + `?q=${encodeURIComponent(`'${DRIVE_FOLDER_ID}' in parents and (${mimeFilter}) and trashed=false`)}`
      + `&fields=files(id,name)`
      + `&orderBy=name`
      + `&pageSize=200`
      + `&key=${DRIVE_API_KEY}`;

    try {
      const res  = await fetch(url);
      const data = await res.json();

      if (data.error) throw new Error(data.error.message);

      galleryImages = data.files || [];
      galleryLoaded = true;
      renderGallery();
    } catch (err) {
      galleryLoadingMsg.innerHTML =
        'The archive could not be reached.<br><em>' + err.message + '</em><br><br>'
        + '<span style="font-size:0.8rem;opacity:0.7;">Ensure the folder is shared as "Anyone with the link can view".</span>';
    }
  }

  /* ── IMAGE URL HELPERS ──────────────────────────────────── */
  function thumbUrl(id) {
    // Drive thumbnail — no auth needed for public files
    return `https://drive.google.com/thumbnail?id=${id}&sz=w400`;
  }

  function fullUrl(id) {
    return `https://drive.google.com/thumbnail?id=${id}&sz=w1600`;
  }

  /* ── ATTRIBUTION HELPER ─────────────────────────────────── */
  // Files are stored as "[Username] filename.ext" — parse both parts
  function parseAttribution(fullName) {
    const match = fullName.match(/^\[([^\]]+)\]\s*(.*)/);
    if (match) return { uploader: match[1], title: match[2] };
    return { uploader: null, title: fullName };
  }

  /* ── RENDER GRID ────────────────────────────────────────── */
  function renderGallery() {
    Array.from(galleryGrid.children).forEach(c => { if (c !== galleryEmpty) c.remove(); });

    const total = galleryImages.length;

    if (total === 0) {
      galleryEmpty.style.display = '';
      galleryLoadingMsg.innerHTML =
        'No images have yet been committed to the archive.<br><em>The page awaits its portraits.</em>';
      galleryCount.style.display = 'none';
      return;
    }

    galleryEmpty.style.display = 'none';
    galleryCount.style.display = '';
    galleryCount.textContent = total + (total === 1 ? ' portrait in the archive' : ' portraits in the archive');

    // Drive images
    galleryImages.forEach((img, i) => {
      const item = document.createElement('div');
      item.className = 'gallery-item';

      const image = document.createElement('img');
      image.src     = thumbUrl(img.id);
      image.alt     = img.name;
      image.loading = 'lazy';
      image.onclick = () => openLightbox(i);

      image.onerror = function () {
        this.onerror = null;
        this.src = `https://lh3.googleusercontent.com/d/${img.id}`;
      };

      const caption = document.createElement('div');
      caption.className = 'gallery-item-caption';
      const { uploader, title } = parseAttribution(img.name);
      const cleanTitle = title.replace(/\.[^/.]+$/, '');
      caption.textContent = cleanTitle;
      if (uploader) {
        const credit = document.createElement('div');
        credit.style.cssText = 'font-size:0.7rem;opacity:0.65;margin-top:2px;font-style:normal;';
        credit.textContent = '✦ ' + uploader;
        caption.appendChild(credit);
      }

      item.appendChild(image);
      item.appendChild(caption);
      galleryGrid.appendChild(item);
    });
  }

