    updateLightbox();
    galleryLightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    galleryLightbox.classList.remove('open');
    document.body.style.overflow = '';
    lightboxImg.src = '';
  }

  function lightboxNav(dir) {
    lightboxIndex = (lightboxIndex + dir + galleryImages.length) % galleryImages.length;
    updateLightbox();
  }

  function updateLightbox() {
    const img = galleryImages[lightboxIndex];
    lightboxImg.src = fullUrl(img.id);
    lightboxImg.alt = img.name;
    const { uploader, title } = parseAttribution(img.name);
    const cleanTitle = title.replace(/\.[^/.]+$/, '');
    const credit = uploader ? ' — uploaded by ' + uploader : '';
    lightboxCaption.textContent =
      cleanTitle + credit + ' — ' + (lightboxIndex + 1) + ' of ' + galleryImages.length;
  }

  galleryLightbox.addEventListener('click', e => {
    if (e.target === galleryLightbox) closeLightbox();
  });

  document.addEventListener('keydown', e => {
    if (galleryLightbox.classList.contains('open')) {
      if (e.key === 'Escape')     closeLightbox();
      if (e.key === 'ArrowLeft')  lightboxNav(-1);
      if (e.key === 'ArrowRight') lightboxNav(1);
    }
    // epub reader escape handled inside epubOpenFile keydown listener
  });
  async function loadFanfics() {
    fanficLoadingMsg.textContent = 'Consulting the scriptorium…';
    fanficEmpty.style.display = '';

    const mimeQ = [
      "mimeType='application/epub+zip'",
      "mimeType='application/pdf'",
      "mimeType='application/octet-stream'"
    ].join(' or ');
    const url = `https://www.googleapis.com/drive/v3/files`
      + `?q=${encodeURIComponent(`'${FANFIC_FOLDER_ID}' in parents and (${mimeQ}) and trashed=false`)}`
      + `&fields=files(id,name,size,modifiedTime,mimeType)`
      + `&orderBy=name`
      + `&pageSize=200`
      + `&key=${DRIVE_API_KEY}`;

    try {
      const res  = await fetch(url);
      const data = await res.json();
      if (data.error) throw new Error(data.error.message);
      fanficFiles  = data.files || [];
      fanficLoaded = true;
      renderFanfics();
    } catch (err) {
      fanficLoadingMsg.innerHTML =
        'The scriptorium could not be reached.<br><em>' + err.message + '</em><br><br>'
        + '<span style="font-size:0.8rem;opacity:0.7;">Ensure the folder is shared as "Anyone with the link can view".</span>';
    }
  }

  /* ── FANFICS: RENDER LIST ───────────────────────────────── */
  function renderFanfics() {
    Array.from(fanficList.children).forEach(c => { if (c !== fanficEmpty) c.remove(); });

    const total = fanficFiles.length;

    if (total === 0) {
      fanficEmpty.style.display = '';
      fanficLoadingMsg.innerHTML =
        'No scrolls have yet been committed to the scriptorium.<br><em>The page awaits its tales.</em>';
      fanficCount.style.display = 'none';
      return;
    }

    fanficEmpty.style.display = 'none';
    fanficCount.style.display = '';
    fanficCount.textContent = total + (total === 1 ? ' scroll in the scriptorium' : ' scrolls in the scriptorium');

    // Drive fanfics
    fanficFiles.forEach(file => {
      const entry = document.createElement('div');
      entry.className = 'fanfic-entry';
      entry.onclick = () => openReader(file);

      const isEpub = file.mimeType === 'application/epub+zip'
                  || /\.epub$/i.test(file.name);

      const icon = document.createElement('div');
      icon.className   = 'fanfic-icon';
      icon.textContent = isEpub ? '📖' : '📜';

      const info = document.createElement('div');
      info.className = 'fanfic-info';

      const { uploader, title: rawTitle } = parseAttribution(file.name);

      const title = document.createElement('div');
      title.className   = 'fanfic-title';
      title.textContent = rawTitle.replace(/\.(epub|pdf)$/i, '');

      const meta = document.createElement('div');
      meta.className = 'fanfic-meta';
      const date = file.modifiedTime
        ? new Date(file.modifiedTime).toLocaleDateString('en-GB', { year:'numeric', month:'long', day:'numeric' })
        : '';
      const size = file.size
        ? (file.size / 1024 > 1024
            ? (file.size / 1048576).toFixed(1) + ' MB'
            : Math.round(file.size / 1024) + ' KB')
        : '';
      const uploaderText = uploader ? '✦ ' + uploader : '';
      meta.textContent = [uploaderText, date, size].filter(Boolean).join(' · ');

      const btn = document.createElement('button');
      btn.className   = 'fanfic-read-btn';
      btn.textContent = 'Read';
      btn.onclick = e => { e.stopPropagation(); epubOpenFile(file); };

      info.appendChild(title);
      info.appendChild(meta);
      entry.appendChild(icon);
      entry.appendChild(info);
      entry.appendChild(btn);
      fanficList.appendChild(entry);
    });
  }

  /* ── EPUB READER ────────────────────────────────────────── */
  let epubBook        = null;
  let epubRendition   = null;
  let epubCurrentSize = 100;  // font size %
  let epubTheme       = 'dark';

  async function epubOpenFile(file) {
    const isEpub = file.mimeType === 'application/epub+zip'
                || /\.epub$/i.test(file.name);

    const { title: epubRawTitle } = parseAttribution(file.name);
    document.getElementById('epubTitle').textContent =
      epubRawTitle.replace(/\.(epub|pdf)$/i, '');
    document.getElementById('epubLoading').style.display = 'flex';
    document.getElementById('epubChapterSelect').innerHTML = '<option value="">Chapters…</option>';
    document.getElementById('epubProgressFill').style.width = '0%';
    document.getElementById('epubChapterLabel').textContent = '—';
    document.getElementById('epubPageLabel').textContent = '—';

    // Destroy previous book
    if (epubRendition) { try { epubRendition.destroy(); } catch(e){} epubRendition = null; }
    if (epubBook)      { try { epubBook.destroy(); }      catch(e){} epubBook = null; }
    // Clear viewer
    const container = document.getElementById('epubViewerContainer');
    Array.from(container.children).forEach(c => {
      if (!c.classList.contains('epub-loading')) c.remove();
    });

    document.getElementById('epubReader').classList.add('open');
    document.body.style.overflow = 'hidden';

    if (!isEpub) {
      // Fallback: open PDF in new tab (Drive preview)
      document.getElementById('epubLoading').style.display = 'none';
      window.open('https://drive.google.com/file/d/' + file.id + '/view', '_blank');
      closeEpubReader();
      return;
    }

    try {
      // Guard: ensure epub.js is loaded
      if (typeof ePub === 'undefined') {
        throw new Error('ePub library not loaded. Please refresh the page and try again.');
      }

      // Fetch the epub from Drive as an ArrayBuffer
      const driveUrl = 'https://www.googleapis.com/drive/v3/files/' + file.id
                     + '?alt=media&key=' + DRIVE_API_KEY;
      const resp = await fetch(driveUrl);
      if (!resp.ok) throw new Error('Could not fetch file (' + resp.status + ')');
      const buffer = await resp.arrayBuffer();

      epubBook = ePub(buffer);

      epubRendition = epubBook.renderTo('epubViewerContainer', {
        width:  '100%',
        height: '100%',
        flow:   'paginated',
        spread: 'none'
      });

      applyEpubTheme();

      await epubRendition.display();
      document.getElementById('epubLoading').style.display = 'none';

      // Load TOC into chapter select
      epubBook.loaded.navigation.then(nav => {
        const sel = document.getElementById('epubChapterSelect');
        sel.innerHTML = '<option value="">— Chapters —</option>';
        function addItems(items) {
          items.forEach(item => {
            const opt = document.createElement('option');
            opt.value       = item.href;
            opt.textContent = item.label.trim();
            sel.appendChild(opt);
            if (item.subitems && item.subitems.length) addItems(item.subitems);
          });
        }
        addItems(nav.toc);
      });

      // Progress + chapter label on location change
      epubRendition.on('locationChanged', loc => {
        if (!loc) return;
        // Chapter label
        epubBook.loaded.navigation.then(nav => {
          const href = loc.start ? loc.start.href : '';
          // Find matching toc item
          function findLabel(items) {
            for (const item of items) {
              if (href && href.includes(item.href.split('#')[0])) return item.label.trim();
              if (item.subitems) { const r = findLabel(item.subitems); if (r) return r; }
            }
            return '';
          }
          const label = findLabel(nav.toc);
          if (label) {
            document.getElementById('epubChapterLabel').textContent = label;
            // Sync chapter select
            const sel = document.getElementById('epubChapterSelect');
            Array.from(sel.options).forEach(o => {
              o.selected = href && href.includes(o.value.split('#')[0]);
            });
          }
        });

        // Progress
        epubBook.locations.percentageFromCfi(loc.start.cfi).then(pct => {
          if (pct !== undefined) {
            const p = Math.round(pct * 100);
            document.getElementById('epubProgressFill').style.width = p + '%';
            document.getElementById('epubPageLabel').textContent    = p + '% read';
          }
        }).catch(() => {});
      });

      // Generate locations for progress (async, background)
      epubBook.locations.generate(1024).catch(() => {});

    } catch(err) {
      document.getElementById('epubLoading').innerHTML =
        '<span style="color:var(--red-ink);font-style:italic;">Could not open: ' + err.message + '</span>';
    }
  }

  function closeEpubReader() {
    document.getElementById('epubReader').classList.remove('open');
    document.body.style.overflow = '';
    if (epubRendition) { try { epubRendition.destroy(); } catch(e){} epubRendition = null; }
    if (epubBook)      { try { epubBook.destroy(); }      catch(e){} epubBook = null; }
  }

  function epubPrev() {
    if (epubRendition) epubRendition.prev();
  }

  function epubNext() {
    if (epubRendition) epubRendition.next();
  }

  function epubFontSize(delta) {
    epubCurrentSize = Math.min(200, Math.max(60, epubCurrentSize + delta));
    if (epubRendition) {
      epubRendition.themes.fontSize(epubCurrentSize + '%');
    }
  }

  function epubGotoChapter(href) {
    if (href && epubRendition) epubRendition.display(href);
  }

  function epubToggleTheme() {
    epubTheme = epubTheme === 'dark' ? 'parchment' : 'dark';
    const reader  = document.getElementById('epubReader');
    const themeBtn = document.getElementById('epubThemeBtn');
    reader.classList.toggle('theme-dark',      epubTheme === 'dark');
    reader.classList.toggle('theme-parchment', epubTheme === 'parchment');
    themeBtn.textContent = epubTheme === 'dark' ? '☽ Dark' : '☀ Parchment';
    applyEpubTheme();
  }

  function applyEpubTheme() {
    if (!epubRendition) return;
    if (epubTheme === 'dark') {
      epubRendition.themes.override('body', 'background:#1a1008 !important; color:#e8d49a !important;');
      epubRendition.themes.override('p',    'color:#c8a86a !important; line-height:1.85 !important; font-size:1rem !important;');
      epubRendition.themes.override('a',    'color:#b8941c !important;');
      epubRendition.themes.override('h1,h2,h3,h4', 'color:#d4b97a !important;');
    } else {
      epubRendition.themes.override('body', 'background:#f4e8c1 !important; color:#2a1a0a !important;');
      epubRendition.themes.override('p',    'color:#4a3320 !important; line-height:1.85 !important; font-size:1rem !important;');
      epubRendition.themes.override('a',    'color:#8b6914 !important;');
      epubRendition.themes.override('h1,h2,h3,h4', 'color:#2a1a0a !important;');
    }
  }

  // Keyboard nav for epub reader
  document.addEventListener('keydown', e => {
    if (!document.getElementById('epubReader').classList.contains('open')) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') epubNext();
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   epubPrev();
    if (e.key === 'Escape') closeEpubReader();
  });

  /* ══════════════════════════════════════════════════════════
     ACCOUNT SYSTEM — plain OAuth2 implicit/token popup
     No GIS library dependency. Works from any origin.
     Profile & custom display name persisted in localStorage.
  ══════════════════════════════════════════════════════════ */

  const OAUTH_CLIENT_ID = '1024782896658-s1ik6q9nptmjapp4pdqugkp12avg7qn7.apps.googleusercontent.com';
  const OAUTH_SCOPE     = encodeURIComponent('https://www.googleapis.com/auth/drive.file openid email profile');
  const LS_USER_KEY     = 'toa_user';
  const LS_DNAME_KEY    = 'toa_dname';
  const LS_TOKEN_KEY    = 'toa_token';
  const LS_TOKEN_EXP    = 'toa_token_exp';

  let oauthToken  = null;
  let currentUser = null;

  function getAttributionName() {
    return localStorage.getItem(LS_DNAME_KEY) || (currentUser && currentUser.name) || 'Scribe';
  }

  // ── Token storage (tokens last ~1 hr) ────────────────────
  function saveToken(token, expiresIn) {
    oauthToken = token;
    localStorage.setItem(LS_TOKEN_KEY, token);
    localStorage.setItem(LS_TOKEN_EXP, Date.now() + (expiresIn - 60) * 1000); // 1-min buffer
  }

  function loadToken() {
    const exp = parseInt(localStorage.getItem(LS_TOKEN_EXP) || '0', 10);
    if (Date.now() < exp) {
      oauthToken = localStorage.getItem(LS_TOKEN_KEY);
    } else {
      oauthToken = null;
      localStorage.removeItem(LS_TOKEN_KEY);
      localStorage.removeItem(LS_TOKEN_EXP);
    }
  }

  // ── Session persistence ───────────────────────────────────
  function saveSession() {
    if (currentUser) localStorage.setItem(LS_USER_KEY, JSON.stringify(currentUser));
    else { localStorage.removeItem(LS_USER_KEY); localStorage.removeItem(LS_TOKEN_KEY); localStorage.removeItem(LS_TOKEN_EXP); }
  }

  function restoreSession() {
    try {
      const raw = localStorage.getItem(LS_USER_KEY);
      if (raw) {
        currentUser = JSON.parse(raw);
        loadToken(); // restore token if not expired
        updateAccountUI();
      }
    } catch(e) { localStorage.removeItem(LS_USER_KEY); }
  }

  // ── OAuth2 popup flow ─────────────────────────────────────
  let _oauthPopup     = null;
  let _oauthPollTimer = null;

  function doGoogleSignIn() {
    showAuthError('');
    const redirectUri = encodeURIComponent(window.location.href.split('?')[0].split('#')[0]);
    const url = 'https://accounts.google.com/o/oauth2/v2/auth'
      + '?client_id='     + OAUTH_CLIENT_ID
      + '&redirect_uri='  + redirectUri
      + '&response_type=token'
      + '&scope='         + OAUTH_SCOPE
      + '&prompt=select_account';

    // Open popup
    const w = 520, h = 620;
    const left = Math.max(0, (screen.width  - w) / 2);
    const top  = Math.max(0, (screen.height - h) / 2);
    _oauthPopup = window.open(url, 'googleOAuth',
      `width=${w},height=${h},left=${left},top=${top},toolbar=no,menubar=no,scrollbars=yes`);

    if (!_oauthPopup) {
      showAuthError('Popup blocked — please allow popups for this page and try again.');
      return;
    }

    // Poll popup URL for the token fragment
    if (_oauthPollTimer) clearInterval(_oauthPollTimer);
    _oauthPollTimer = setInterval(() => {
      try {
        if (!_oauthPopup || _oauthPopup.closed) {
          clearInterval(_oauthPollTimer);
          return;
        }
        const href = _oauthPopup.location.href;
        if (href && href.indexOf(window.location.hostname) !== -1) {
          clearInterval(_oauthPollTimer);
          _oauthPopup.close();
          const params = new URLSearchParams(href.split('#')[1] || '');
          const token  = params.get('access_token');
          const expIn  = parseInt(params.get('expires_in') || '3600', 10);
          if (token) {
            saveToken(token, expIn);
            fetchAndSaveProfile(token);
          } else {
            showAuthError('Sign-in failed — no token received. Please try again.');
          }
        }
      } catch(e) { /* cross-origin — popup still on Google's domain, keep waiting */ }
    }, 300);
  }

  function fetchAndSaveProfile(token) {
    fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
      headers: { Authorization: 'Bearer ' + token }
    })
    .then(r => r.json())
    .then(profile => {
      const displayName = profile.name
        || ((profile.given_name || '') + ' ' + (profile.family_name || '')).trim()
        || profile.email || 'Scribe';
      currentUser = { name: displayName, email: profile.email, picture: profile.picture || '' };
      saveSession();
      closeAuthModal();
      updateAccountUI();
      if (galleryLoaded) { galleryLoaded = false; loadGallery(); }
      if (fanficLoaded)  { fanficLoaded  = false; loadFanfics(); }
    })
    .catch(() => showAuthError('Signed in but could not fetch profile. Please try again.'));
  }

  function showAuthError(msg) {
    const el = document.getElementById('loginError');
    if (el) el.textContent = msg;
  }

  // ── Sign-in / out ─────────────────────────────────────────
  function openAuthModal() {
    showAuthError('');
    document.getElementById('authModal').classList.add('open');
  }

  function closeAuthModal() {
    document.getElementById('authModal').classList.remove('open');
  }

  function acctLogout() {
    oauthToken  = null;
    currentUser = null;
    saveSession();
    updateAccountUI();
    if (galleryLoaded) { galleryLoaded = false; loadGallery(); }
    if (fanficLoaded)  { fanficLoaded  = false; loadFanfics(); }
  }

  // ── Set Display Name modal ────────────────────────────────
  function openSetNameModal() {
    const current = localStorage.getItem(LS_DNAME_KEY) || (currentUser && currentUser.name) || '';
    document.getElementById('displayNameInput').value = current;
    document.getElementById('setNameModal').classList.add('open');
    setTimeout(() => document.getElementById('displayNameInput').focus(), 50);
  }

  function closeSetNameModal() {
    document.getElementById('setNameModal').classList.remove('open');
  }

  function saveDisplayName() {
    const val = document.getElementById('displayNameInput').value.trim();
    if (!val) { alert('Please enter a display name.'); return; }
    localStorage.setItem(LS_DNAME_KEY, val);
    closeSetNameModal();
    updateAccountUI();
  }

  // Close modals on overlay click
  document.getElementById('authModal').addEventListener('click', function(e) {
    if (e.target === this) closeAuthModal();
  });
  document.getElementById('setNameModal').addEventListener('click', function(e) {
    if (e.target === this) closeSetNameModal();
  });

  // ── UI state ─────────────────────────────────────────────
  function updateAccountUI() {
    const nameEl       = document.getElementById('acctName');
    const logoutBtn    = document.getElementById('acctLogoutBtn');
    const setNameBtn   = document.getElementById('acctSetNameBtn');
    const loginBtn     = document.getElementById('acctLoginBtn');

    if (currentUser) {
      const displayName = localStorage.getItem(LS_DNAME_KEY) || currentUser.name;
      nameEl.textContent = '✦ ' + displayName;
      nameEl.style.display    = '';
      logoutBtn.style.display = '';
      setNameBtn.style.display = '';
      loginBtn.style.display  = 'none';
    } else {
      nameEl.style.display     = 'none';
      logoutBtn.style.display  = 'none';
      setNameBtn.style.display = 'none';
      loginBtn.style.display   = '';
    }

    const gUp = document.getElementById('galleryUploadPanel');
    const fUp = document.getElementById('fanficUploadPanel');
    if (gUp) gUp.classList.toggle('visible', !!currentUser);
    if (fUp) fUp.classList.toggle('visible', !!currentUser);
  }

  // ── Drive upload helper ───────────────────────────────────
  async function uploadToDrive(file, folderId) {
    if (!oauthToken) throw new Error('Not signed in.');

    const metadata = {
      name:    file.name,
      parents: [folderId]
    };

    const form = new FormData();
    form.append('metadata', new Blob([JSON.stringify(metadata)], { type: 'application/json' }));
    form.append('file', file);

    const res = await fetch(
      'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name',
      {
        method:  'POST',
        headers: { Authorization: 'Bearer ' + oauthToken },
        body:    form
      }
    );

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error?.message || 'Upload failed (' + res.status + ')');
    }

    // Make the file publicly readable so everyone can view it
    const data = await res.json();
    await fetch('https://www.googleapis.com/drive/v3/files/' + data.id + '/permissions', {
      method:  'POST',
      headers: {
        Authorization:  'Bearer ' + oauthToken,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ role: 'reader', type: 'anyone' })
    });

    return data; // { id, name }
  }

  // ── Gallery upload ────────────────────────────────────────
  let galleryPendingFile = null;

  function galleryFileChosen(input) {
    galleryPendingFile = input.files[0] || null;
    document.getElementById('galleryFileName').textContent =
      galleryPendingFile ? galleryPendingFile.name : 'No file chosen';
  }

  async function submitGalleryUpload() {
    if (!currentUser) { alert('Please sign in to upload.'); return; }
    if (!galleryPendingFile) { alert('Please choose an image file first.'); return; }

    const btn = document.querySelector('#galleryUploadPanel .upload-submit');
    btn.textContent = 'Uploading…';
    btn.disabled = true;

    try {
      // Prefix filename with [DisplayName] so authorship is stored in Drive
      const attributedName = '[' + getAttributionName() + '] ' + galleryPendingFile.name;
      const attributedFile = new File([galleryPendingFile], attributedName, { type: galleryPendingFile.type });
      await uploadToDrive(attributedFile, DRIVE_FOLDER_ID);
      galleryPendingFile = null;
      document.getElementById('galleryFileName').textContent = 'No file chosen';
      document.getElementById('galleryFileInput').value = '';
      // Reload gallery from Drive so the new image appears
      galleryLoaded = false;
      await loadGallery();
    } catch(e) {
      alert('Upload failed: ' + e.message);
    } finally {
      btn.textContent = 'Submit to Archive';
      btn.disabled = false;
    }
  }

  // ── Fanfic upload ─────────────────────────────────────────
  let fanficPendingFile = null;

  function fanficFileChosen(input) {
    fanficPendingFile = input.files[0] || null;
    document.getElementById('fanficFileName').textContent =
      fanficPendingFile ? fanficPendingFile.name : 'No file chosen';
  }

  async function submitFanficUpload() {
    if (!currentUser) { alert('Please sign in to upload.'); return; }
    if (!fanficPendingFile) { alert('Please choose an EPUB or PDF file first.'); return; }

    const btn = document.querySelector('#fanficUploadPanel .upload-submit');
    btn.textContent = 'Uploading…';
    btn.disabled = true;

    try {
      // Prefix filename with [DisplayName] so authorship is stored in Drive
      const attributedName = '[' + getAttributionName() + '] ' + fanficPendingFile.name;
      const attributedFile = new File([fanficPendingFile], attributedName, { type: fanficPendingFile.type });
      await uploadToDrive(attributedFile, FANFIC_FOLDER_ID);
      fanficPendingFile = null;
      document.getElementById('fanficFileName').textContent = 'No file chosen';
      document.getElementById('fanficFileInput').value = '';
      // Reload fanfics from Drive so the new PDF appears
      fanficLoaded = false;
      await loadFanfics();
    } catch(e) {
      alert('Upload failed: ' + e.message);
    } finally {
      btn.textContent = 'Submit to Scriptorium';
      btn.disabled = false;
    }
  }

  // ── Initialise UI on load ─────────────────────────────────
  restoreSession(); // restores persisted login then calls updateAccountUI internally
  if (!currentUser) updateAccountUI(); // ensure logged-out state shown if no session

</script>
